# Copy to .env and change the secrets
POSTGRES_USER=supportpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=supportpilot
APP_DB_PASSWORD=change-me-app-user
APP_WORKER_DB_PASSWORD=change-me-worker-user
DATABASE_URL=postgresql+asyncpg://app_user:change-me-app-user@localhost:5432/supportpilot
WORKER_DATABASE_URL=postgresql+asyncpg://worker_user:change-me-worker-user@localhost:5432/supportpilot
MIGRATION_DATABASE_URL=postgresql+asyncpg://supportpilot:change-me@localhost:5432/supportpilot
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=replace-with-development-access-key
S3_SECRET_KEY=replace-with-long-random-secret
S3_BUCKET=supportpilot-docs
S3_REGION=us-east-1
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRE_MINUTES=60
CHAT_RATE_LIMIT_USER_PER_MINUTE=20
CHAT_RATE_LIMIT_TENANT_PER_MINUTE=120
EMBED_CACHE_TTL_SECONDS=3600